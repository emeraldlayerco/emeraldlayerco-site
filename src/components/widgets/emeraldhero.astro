---
import facebookLogo from '~/assets/images/facebooklogo.png';
---

<section class="py-12">

  <div class="max-w-7xl mx-auto px-6">

    <img
      src={facebookLogo.src}
      alt="Emerald Layer Company"
      class="w-full rounded-3xl shadow-2xl"
    />

    <div class="text-center mt-12">

      <h1 class="text-5xl md:text-6xl font-extrabold leading-tight">
        Bringing Your Ideas to Life
      </h1>

      <p class="mt-6 text-2xl font-semibold text-emerald-600">
        Premium 3D Printing Made in Humboldt County, California
      </p>

      <p class="mt-8 max-w-3xl mx-auto text-lg text-gray-600 dark:text-gray-300 leading-8">
        Emerald Layer Company creates premium 3D printed products from original planter designs and best-selling
        koozies to custom signs, automotive accessories, home décor, and
        one-of-a-kind custom creations, every item is proudly designed
        and printed in McKinleyville, California.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">

        <a
          href="/shop"
          class="rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-4 font-semibold transition"
        >
          Shop Products
        </a>

        <a
          href="/custom-printing"
          class="rounded-xl border border-emerald-600 text-emerald-600 hover:bg-emerald-50 dark:hover:bg-slate-800 px-8 py-4 font-semibold transition"
        >
          Request a Quote
        </a>

      </div>

    </div>

  </div>

</section>