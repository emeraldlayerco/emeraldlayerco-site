<section>

  <h2 class="text-2xl font-bold mb-6">
    Your Information
  </h2>

  <div class="grid md:grid-cols-2 gap-6">

    <input
      name="name"
      type="text"
      placeholder="Full Name *"
      required
      class="border rounded-xl p-4 w-full"
    />

    <input
      name="email"
      type="email"
      placeholder="Email Address *"
      required
      class="border rounded-xl p-4 w-full"
    />

    <input
      name="phone"
      type="tel"
      placeholder="Phone Number"
      class="border rounded-xl p-4 w-full"
    />

    <input
      name="business"
      type="text"
      placeholder="Business Name (Optional)"
      class="border rounded-xl p-4 w-full"
    />

  </div>

</section>