---
import Layout from '~/layouts/PageLayout.astro';

import ContactInformation from '~/components/start-project/ContactInformation.astro';
import ProjectDetails from '~/components/start-project/ProjectDetails.astro';
import PrintDetails from '~/components/start-project/PrintDetails.astro';
import FileUpload from '~/components/start-project/FileUpload.astro';
import AdditionalNotes from '~/components/start-project/AdditionalNotes.astro';
import SuccessPanel from '~/components/start-project/SuccessPanel.astro';

const metadata = {
  title: 'Start Your Project | Emerald Layer Company',
};
---

<Layout metadata={metadata}>

<section class="py-20">

  <div class="max-w-4xl mx-auto px-6">

    <div class="text-center mb-16">

      <h1 class="text-5xl font-bold mb-6">
        Start Your Project
      </h1>

      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Whether you already have a printable file or just an idea, we'd love to
        help bring your project to life. The more information you provide, the
        more accurate your quote will be.
      </p>

    </div>

    <form
      id="projectForm"
      class="space-y-12"
      enctype="multipart/form-data"
    >

      <ContactInformation />

      <ProjectDetails />

      <PrintDetails />

      <FileUpload />

      <AdditionalNotes />

      <div class="text-center pt-6">

        <button
          id="submitButton"
          type="submit"
          class="bg-emerald-600 hover:bg-emerald-700 text-white px-10 py-5 rounded-xl text-lg font-semibold transition disabled:opacity-50"
        >
          Submit Project Request
        </button>

      </div>

    </form>

    <SuccessPanel />

  </div>

</section>

<script>
const form = document.getElementById('projectForm');
const button = document.getElementById('submitButton');
const successPanel = document.getElementById('successPanel');

form?.addEventListener('submit', async (e) => {

  e.preventDefault();

  button.disabled = true;
  button.textContent = 'Submitting...';

  const formData = new FormData(form);

  try {

    const response = await fetch('/api/start-project', {
      method: 'POST',
      body: formData,
    });

    const result = await response.json();

    if (result.success) {

      form.style.display = 'none';

      successPanel.classList.remove('hidden');

      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });

    } else {

      alert('Something went wrong. Please try again.');

      button.disabled = false;
      button.textContent = 'Submit Project Request';

    }

  } catch (error) {

    console.error(error);

    alert('Unable to contact the server.');

    button.disabled = false;
    button.textContent = 'Submit Project Request';

  }

});
</script>

</Layout>